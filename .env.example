# Copy to .env, then run python3 scripts/init_env.py. Never commit real secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Generated locally by scripts/init_env.py:
# POSTGRES_PASSWORD, OPENPROJECT_DB_PASSWORD, APP_DB_PASSWORD,
# OPENPROJECT_SECRET_KEY_BASE, COLLABORATIVE_SERVER_SECRET,
# BOOKSTACK_DB_PASSWORD, MARIADB_ROOT_PASSWORD, BOOKSTACK_APP_KEY
# Stage 1: run scripts/bootstrap_runtime.py after reviewing its access changes.
# APP_RUNTIME_DB_PASSWORD, APP_API_TOKEN, OPENPROJECT_PM_TOKEN,
# OPENPROJECT_SA_TOKEN, AGENT_USER_IDS, OPENPROJECT_STATUS_IDS,
# BOOKSTACK_RUNTIME_TOKEN_ID, BOOKSTACK_RUNTIME_TOKEN_SECRET are generated locally.
LLM_BACKEND=openrouter
LLM_STRUCTURED_MODE=json_object
LLM_REASONING_MODE=disabled
# Estimated tariffs; align with the chosen model before interpreting cost budgets.
LLM_INPUT_USD_PER_MILLION=1
LLM_OUTPUT_USD_PER_MILLION=4

SANDBOX_DB_PASSWORD=
SANDBOX_API_TOKEN=
GIT_BROKER_API_TOKEN=
GITHUB_RUNTIME_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PUBLIC_URL=
TELEMETRY_METRICS_TOKEN=

# Optional private object storage; API uses separate read-only credentials.
ARTIFACT_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_PREFIX=artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_READ_ACCESS_KEY_ID=
S3_READ_SECRET_ACCESS_KEY=
S3_ALLOW_LOCAL_HTTP=false

# Optional external PostgreSQL. Different roles; never give migration credentials to runtime.
# Nonlocal host requires sslmode=verify-full and sslrootcert=/run/secrets/postgres-ca.crt.
APP_DATABASE_URL=
APP_MIGRATION_DATABASE_URL=
SANDBOX_DATABASE_URL=
# LLM_BACKEND=private is a fail-closed stub, not a working private model integration.

# Host-only product operator; API validates, worker never receives this credential.
PRODUCT_OPERATOR_TOKEN=

GITHUB_PRODUCT_BASE_REF=release/302
