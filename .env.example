# Copy to .env, then run python3 scripts/init_env.py. Never commit real secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Generated locally by scripts/init_env.py:
# POSTGRES_PASSWORD, OPENPROJECT_DB_PASSWORD, APP_DB_PASSWORD,
# OPENPROJECT_SECRET_KEY_BASE, COLLABORATIVE_SERVER_SECRET,
# BOOKSTACK_DB_PASSWORD, MARIADB_ROOT_PASSWORD, BOOKSTACK_APP_KEY
# Stage 1: run scripts/bootstrap_runtime.py after reviewing its access changes.
# APP_RUNTIME_DB_PASSWORD, APP_API_TOKEN, OPENPROJECT_PM_TOKEN,
# OPENPROJECT_SA_TOKEN, AGENT_USER_IDS, OPENPROJECT_STATUS_IDS,
# BOOKSTACK_RUNTIME_TOKEN_ID, BOOKSTACK_RUNTIME_TOKEN_SECRET are generated locally.
LLM_BACKEND=openrouter
LLM_STRUCTURED_MODE=json_object
# Estimated tariffs; align with the chosen model before interpreting cost budgets.
LLM_INPUT_USD_PER_MILLION=1
LLM_OUTPUT_USD_PER_MILLION=4
